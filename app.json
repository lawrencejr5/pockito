{
  "expo": {
    "name": "pockito",
    "slug": "pockito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pockito",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01a1bf68-5f36-7ce9-a255-72f08b164abd"
    },
    "ios": {
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.lawrencejr.pockito",
       "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#a5a79b"
        }
      ],
       [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pockito needs access to your photos so you can attach receipts to transactions.",
          "cameraPermission": "Pockito needs camera access so you can photograph receipts."
        }
      ],
      "expo-build-properties",
      "expo-localization",
      "expo-updates",
      "expo-secure-store",
      "expo-tracking-transparency",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7078901325871517~9925359301",
          "iosAppId": "ca-app-pub-7078901325871517~7148646014"
        }

      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e061d89-24eb-4d23-802c-5e72d8e052ba"
      },
      "convexUrl": "https://exciting-warthog-322.convex.cloud"
    },
    "owner": "lawrencejr"
  }
}
